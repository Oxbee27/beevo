# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beevo
DB_USER=beevo_app
DB_PASSWORD=replace_with_your_local_database_password
DB_SSL=false

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
MESSAGE_WORKER_POLL_INTERVAL_MS=5000
MESSAGE_WORKER_BATCH_SIZE=10

# Paystack wallet funding
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# Product restock campaign processing
RESTOCK_CAMPAIGN_BATCH_SIZE=10

# Database SSL certificate verification
DB_SSL_REJECT_UNAUTHORIZED=true

# Password reset link destination (configure when the frontend is available)
FRONTEND_URL=

# Resend webhook verification
RESEND_WEBHOOK_SECRET=

# Termii SMS configuration
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=
TERMII_SMS_CHANNEL=
TERMII_WEBHOOK_SECRET=

# WhatsApp Cloud API configuration
# Tenant access tokens are encrypted in the database using this optional key.
# Generate with: openssl rand -hex 32
# Required before connecting a business WhatsApp account, not at application startup.
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Shared Meta webhook configuration
WHATSAPP_API_VERSION=v26.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional in-process automation worker
ENABLE_EMBEDDED_WORKER=false
